{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Git Control",
  "version": "0.1.0",
  "identifier": "com.gitcontrol.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Git Control",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "visible": true,
        "center": true,
        "focus": true,
        "transparent": false,
        "decorations": true,
        "resizable": true,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Git Control Contributors",
    "category": "DeveloperTool",
    "shortDescription": "Blazing-fast, glassmorphic desktop Git GUI & interactive commit graph",
    "longDescription": "Git Control is a modern, cross-platform desktop Git GUI and interactive angular commit graph built with Tauri v2 (Rust), React 18, TypeScript, and Monaco Editor.",
    "copyright": "Copyright © 2026 Diki & Git Control Contributors. Licensed under MIT.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
